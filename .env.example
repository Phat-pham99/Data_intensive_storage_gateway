# Application
APP_NAME="Explainable Data Lifecycle Control Plane"
ENVIRONMENT=development
DEBUG=false

# PostgreSQL (SQLAlchemy URL; psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://lifecycle:lifecycle@localhost:5432/lifecycle

# Redis (broker / result backend)
REDIS_URL=redis://localhost:6379/0
# Optional overrides; fall back to REDIS_URL when unset
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# S3 / object storage (used from Phase 2 onward)
S3_REGION=us-east-1
S3_BUCKET=lifecycle-dev
# S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Admin auth for /v1/admin/* endpoints (Phase 5)
# ADMIN_API_KEY=
